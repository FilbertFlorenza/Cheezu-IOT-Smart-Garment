APP_NAME="Garment QC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Timestamps are stored in UTC; this zone is used only for rendering.
APP_DISPLAY_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garment_defect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@garment.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Seeded accounts (used by `php artisan db:seed` only)
# ---------------------------------------------------------------------------
# Replace these before seeding anything other than a local development database.
ADMIN_EMAIL=admin@garment.test
ADMIN_PASSWORD=password
OPERATOR_PASSWORD=password

# ---------------------------------------------------------------------------
# Inspection monitoring
# ---------------------------------------------------------------------------
INSPECTION_ONLINE_THRESHOLD_MINUTES=15
INSPECTION_BACKFILL_DAYS=7
INSPECTION_FUTURE_TOLERANCE_MINUTES=5
INSPECTION_IMAGE_MAX_KB=5120
INSPECTION_IMAGE_MAX_DIMENSION=4096

# `local` stores images privately under storage/app/private and serves them
# through signed, expiring URLs. Use `s3` for an S3-compatible bucket.
INSPECTION_IMAGE_DISK=local

# ---------------------------------------------------------------------------
# Forecast ingestion
# ---------------------------------------------------------------------------
FORECAST_MAX_PREDICTIONS=500
FORECAST_MAX_HORIZON_MINUTES=10080

# ---------------------------------------------------------------------------
# Object storage (S3 or S3-compatible such as MinIO)
# ---------------------------------------------------------------------------
# Leave blank when FILESYSTEM_DISK and INSPECTION_IMAGE_DISK are `local`.
# Prefer an IAM task role in AWS instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Container runtime flags (read by docker/entrypoint.sh, not by Laravel)
# ---------------------------------------------------------------------------
# RUN_MIGRATIONS=false
# RUN_SEED=false
# WAIT_FOR_DB=false
# DB_WAIT_ATTEMPTS=30
# OPTIMIZE=true
