# Copy to .env.docker and replace every change-me value before starting:
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# This file is read by Docker Compose for variable substitution, not by the
# application at runtime. The container receives the resolved values.

APP_NAME="Garment QC"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=
APP_DISPLAY_TIMEZONE=Asia/Manila
APP_PORT=8080
LOG_LEVEL=debug

DB_DATABASE=garment_defect
DB_USERNAME=garment
DB_PASSWORD=change-me-strong-db-password
DB_ROOT_PASSWORD=change-me-strong-root-password
DB_PORT_FORWARD=3307

ADMIN_EMAIL=admin@garment.test
ADMIN_PASSWORD=change-me-admin-password
OPERATOR_PASSWORD=change-me-operator-password

RUN_MIGRATIONS=true
# Set RUN_SEED=false after the first successful start: seeding again resets the
# administrator and operator passwords to the values in this file.
RUN_SEED=true
OPTIMIZE=true

# ---------------------------------------------------------------------------
# Optional S3-compatible storage (MinIO overlay)
# ---------------------------------------------------------------------------
# Uncomment the block below and start with:
#   docker compose --env-file .env.docker \
#     -f docker-compose.yml -f docker-compose.s3.yml up --build
#
# FILESYSTEM_DISK=s3
# INSPECTION_IMAGE_DISK=s3
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=change-me-minio-application-secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=garment-inspection-images
# AWS_ENDPOINT=http://minio:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=change-me-minio-root-password
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
